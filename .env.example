# Copy to .env and fill in. Never commit .env.
# HARNESSX_* is preferred; MYAGENT_* is accepted as a fallback.
HARNESSX_BASE_URL=https://api.deepseek.com
HARNESSX_MODEL=deepseek-v4-flash
HARNESSX_API_KEY=
# Optional limits
# HARNESSX_MAX_STEPS=30
# HARNESSX_MAX_COST=0.5
# HARNESSX_MAX_SECONDS=600
# HARNESSX_TOOL_TIMEOUT=60
# 0 disables context compaction; set e.g. 6000 to enable compaction
# HARNESSX_CONTEXT_LIMIT=0
# Number of most recent turns (one assistant message + its tool results) kept verbatim when compacting
# HARNESSX_KEEP_TURNS=2
# Compaction summary: llm (costs extra tokens, keeps facts) or rule (free, does not copy tool output)
# HARNESSX_SUMMARIZER=llm
# Estimated price per million tokens (currency of your choice); used only for the cost limit
# HARNESSX_PRICE_IN=1.0
# HARNESSX_PRICE_OUT=2.0
